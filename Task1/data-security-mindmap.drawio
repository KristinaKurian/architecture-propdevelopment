hiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="580" width="260" height="170" as="geometry"/></mxCell><mxCell id="31" value="Утечка — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="260" height="55" as="geometry"/></mxCell><mxCell id="33" value="Внутренняя информация может помочь злоумышленнику исследовать инфраструктуру." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="760" width="330" height="70" as="geometry"/></mxCell><mxCell id="35" value="Потеря — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="875" width="260" height="55" as="geometry"/></mxCell><mxCell id="37" value="Усложнится разработка, эксплуатация и восстановление систем." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="875" width="330" height="70" as="geometry"/></mxCell><mxCell id="39" value="Искажение — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="260" height="55" as="geometry"/></mxCell><mxCell id="41" value="Ошибочная документация приводит к неправильным изменениям систем." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="990" width="330" height="70" as="geometry"/></mxCell><mxCell id="43" value="Некачественные данные — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1105" width="260" height="55" as="geometry"/></mxCell><mxCell id="45" value="Команды могут принимать решения на основании неправильной информации." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="1105" width="330" height="70" as="geometry"/></mxCell><mxCell id="47" value="Обесценивание — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1220" width="260" height="55" as="geometry"/></mxCell><mxCell id="49" value="Устаревшая документация перестаёт отражать реальную архитектуру." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="1220" width="330" height="70" as="geometry"/></mxCell><mxCell id="51" value="Конфиденциальные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1350" y="120" width="240" height="60" as="geometry"/></mxCell><mxCell id="53" value="&lt;b&gt;Примеры данных&lt;/b&gt;&lt;br&gt;Ф. И. О.&lt;br&gt;Телефон&lt;br&gt;Email&lt;br&gt;Данные CRM&lt;br&gt;Данные собственников&lt;br&gt;Бронирования&lt;br&gt;Результаты осмотров&lt;br&gt;Данные онлайн-сделок&lt;br&gt;Документы клиентов&lt;br&gt;Данные ЖКУ&lt;br&gt;История платежей&lt;br&gt;Данные партнёров" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="210" width="260" height="170" as="geometry"/></mxCell><mxCell id="55" value="Утечка — Критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="80" width="260" height="55" as="geometry"/></mxCell><mxCell id="57" value="Возможна утечка персональных, финансовых и имущественных данных." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="80" width="330" height="70" as="geometry"/></mxCell><mxCell id="59" value="Потеря — Критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="195" width="260" height="55" as="geometry"/></mxCell><mxCell id="61" value="Будут нарушены процессы продаж, сделок и обслуживания собственников." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="195" width="330" height="70" as="geometry"/></mxCell><mxCell id="63" value="Искажение — Критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="310" width="260" height="55" as="geometry"/></mxCell><mxCell id="65" value="Изменение информации о сделке, собственности или платеже может привести к юридическим и финансовым последствиям." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="310" width="330" height="70" as="geometry"/></mxCell><mxCell id="67" value="Некачественные данные — Критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="425" width="260" height="55" as="geometry"/></mxCell><mxCell id="69" value="Уже существуют случаи отображения одному клиенту данных другого клиента." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="425" width="330" height="70" as="geometry"/></mxCell><mxCell id="71" value="Обесценивание — Значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="540" width="260" height="55" as="geometry"/></mxCell><mxCell id="73" value="Устаревшие данные снижаю